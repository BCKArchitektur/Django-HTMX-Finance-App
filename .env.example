# BCK Architektur Finance App — Environment Variables
# Copy this file to .env for local development.
# NEVER commit .env to git (it is already in .gitignore).

# ── Django Core ────────────────────────────────────────────────────────────────

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True for local development, False in production
DEBUG=True

# Comma-separated list of allowed hostnames
# Production example: your-app.herokuapp.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────────────────────────

# PostgreSQL connection URL
# Heroku sets this automatically via the Heroku Postgres add-on
# Local example: postgresql://postgres:password@localhost:5432/bck_finance
DATABASE_URL=postgresql://postgres:password@localhost:5432/bck_2

# ── Heroku Build (Optional) ────────────────────────────────────────────────────

# Set to 1 to skip collectstatic during Heroku build (useful if static files are pre-built)
# DISABLE_COLLECTSTATIC=1
